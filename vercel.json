{
  "version": 2,
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Backend/config/**",
          "Backend/models/**",
          "Backend/controllers/**",
          "Backend/routes/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/server.js"
    },
    {
      "src": "/",
      "dest": "Backend/server.js"
    }
  ]
}